{
    "name": "turismo-la-paz/api",
    "description": "API Turística La Paz Bolivia - Sincronización uMap <-> MySQL Aiven",
    "type": "project",
    "version": "3.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Turismo La Paz",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-xml": "*",
        "ext-openssl": "*"
    },
    "require-dev": {},
    "autoload": {
        "files": [
            "config/database.php"
        ],
        "psr-4": {
            "TurismoLaPaz\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-install-cmd": [
            "mkdir -p data/umap_cache || true",
            "chmod 775 data/umap_cache 2>/dev/null || true"
        ]
    }
}
